<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VIP Login UI</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background: #0f172a;
            color: #ffffff;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }
        .login-card {
            background: #1e293b;
            padding: 30px;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            width: 100%;
            max-width: 380px;
            text-align: center;
            border: 1px solid #334155;
        }
        .login-card h2 {
            color: #ff9500;
            margin-bottom: 8px;
            font-size: 24px;
        }
        .login-card p {
            color: #94a3b8;
            font-size: 13px;
            margin-bottom: 24px;
        }
        .input-group {
            margin-bottom: 18px;
            text-align: left;
        }
        .input-group label {
            display: block;
            font-size: 12px;
            color: #cbd5e1;
            margin-bottom: 6px;
        }
        .input-group input {
            width: 100%;
            padding: 12px 14px;
            border-radius: 8px;
            border: 1px solid #475569;
            background: #0f172a;
            color: #fff;
            font-size: 14px;
            outline: none;
        }
        .input-group input:focus {
            border-color: #ff9500;
        }
        .btn {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 8px;
            background: #ff9500;
            color: #fff;
            font-weight: bold;
            font-size: 15px;
            cursor: pointer;
            transition: 0.2s;
        }
        .btn:active {
            transform: scale(0.98);
        }
        .footer-link {
            margin-top: 15px;
            font-size: 12px;
            color: #64748b;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <h2>TDR MODZ VIP</h2>
        <p>Enter your key to access the panel</p>
        
        <div class="input-group">
            <label>LICENSE KEY</label>
            <input type="text" id="licenseKey" placeholder="Paste key here...">
        </div>

        <button class="btn" onclick="submitLogin()">LOGIN NOW</button>

        <div class="footer-link">
            Protected by Encrypted Gateway
        </div>
    </div>

    <script>
        function submitLogin() {
            var key = document.getElementById('licenseKey').value;
            if(key.trim() === "") {
                alert("Please enter a key!");
                return;
            }
            // 🔥 Lua Script-এর সাথে ডাটা পাস করা হচ্ছে
            if(typeof AndroidLua !== 'undefined') {
                AndroidLua.onLoginSuccess();
            } else {
                alert("Login Success (Browser Test)");
            }
        }
    </script>
</body>
</html>
